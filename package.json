    "json-ld",
    "open-graph",
    "pagespeed-insights",
    "core-web-vitals",
    "accessibility",
    "security-headers",
    "llms.txt",
    "cli"
  ],
  "homepage": "https://github.com/BYDTechSolutions/site-audit#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/site-audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/site-audit.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
